{
    "name" : "Trickery",
    "func_name" : "Trickery",
    "type" : "CardType.SPELL",
    "description" : "Pick a card in the chain and move it behind a different card in chain.",
    "func" : [
        "chain_length = len(chain)",
        "if chain_length <= 1:",
        "    print('There are not enough cards in chain to move.')",
        "    return",
        "while True:",
        "    print(f'{ps[\"name\"]}, pick a card based off it\\'s place number in the chain.')",
        "    print('Current Chain:', [card[0] for card in chain])",
        "    command = input('> ')",
        "    try:",
        "        command = int(command)",
        "        if command > 0 and command <= chain_length:",
        "            card = chain.pop(command-1)",
        "            ordered_chain.pop(-command)",
        "            new_chain_length = chain_length - 1",
        "            while True:",
        "                print('Choose a place number to put the card behind')",
        "                print('Chain:', [card[0] for card in chain])",
        "                new_index = input('> ')",
        "                try:",
        "                    i = int(new_index)",
        "                    if i > 0 and i <= new_chain_length:",
        "                        chain.insert(i - 1, card)",
        "                        ordered_chain.insert(-i, card)",
        "                        print('New Chain:', [card[0] for card in chain])",
        "                        return",
        "                    else:",
        "                        print(f'{new_index} is not between 1-{new_chain_length} (chain size)')",
        "                except ValueError:",
        "                    print(f'{new_index} is not a valid number')",
        "        else:",
        "            print(f'{command} is not between 1-{chain_length} (chain size)')",
        "    except ValueError:",
        "        print(f'{command} is not a valid number')"
    ]
}